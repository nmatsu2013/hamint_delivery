# PostgreSQL connection string (Supabase session pooler recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# HTTP server
PORT=3000
NODE_ENV=development
# Comma separated origins allowed for browser access. Use * for local dev.
CORS_ORIGIN=http://localhost:5173

# Supabase Auth (JWT verification)
# Either SUPABASE_URL (JWKS is loaded from /auth/v1/.well-known/jwks.json)
# or SUPABASE_JWT_SECRET (legacy HS256 secret) is required in production.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Development-only tokens: "dev:<role>:<email>". NEVER enable in production.
ALLOW_DEV_AUTH=true

# Optional: fix the business date for acceptance tests / demos (YYYY-MM-DD).
# Leave empty in production (Asia/Tokyo today is used).
BUSINESS_DATE=

# Frontend (Vite)
VITE_API_BASE_URL=/api
VITE_DEV_AUTH=true
