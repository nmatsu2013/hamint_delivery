# PostgreSQL connection string (Supabase session pooler recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# HTTP server
PORT=3000
NODE_ENV=development
# Comma separated origins allowed for browser access. Use * for local dev.
CORS_ORIGIN=http://localhost:5173

# Simple login
LOGIN_USER_ID=hamint_user
LOGIN_PASSWORD=hamint_password

# Optional: fix the business date for acceptance tests / demos (YYYY-MM-DD).
# Leave empty in production (Asia/Tokyo today is used).
BUSINESS_DATE=

# Frontend (Vite)
VITE_API_BASE_URL=/api
